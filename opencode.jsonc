{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "allow",
      "curl * | *sh*": "deny",
      "curl * | sudo *": "deny",
      "wget * | *sh*": "deny",
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "dd * of=/dev/*": "deny",
      "mkfs*": "deny",
      "*: () { * }:*;*": "deny",
      "sudo *": "ask",
      "chmod -R *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "systemctl *": "ask",
      "docker *": "ask",
      "git push *": "ask",
      "gh *": "ask"
    },
    "webfetch": "ask",
    "websearch": "allow",
    "external_directory": {
      "~/secrets/**": "deny",
      "*": "ask"
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    }
  },
  "provider": {
    "gx10-tp2": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.0.206:8000/v1",
        "apiKey": "local"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash 1017 2.9bpw (TensorFold TP2, 2x Spark)",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ]
          }
        },
        "ds41": {
          "name": "deepseek-v4.1-flash alias (TensorFold TP2, 2x Spark)",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ]
          }
        }
      }
    }
  },
  "references": {
    "pydantic-ai": {
      "repository": "pydantic/pydantic-ai",
      "description": "Use for pydantic-ai library source code, API details, and usage examples"
    },
    "flue": {
      "repository": "withastro/flue",
      "description": "Use for Flue agent harness framework source code, API details, and usage examples"
    },
    "pi": {
      "repository": "earendil-works/pi",
      "description": "Use for Pi agent toolkit source code (coding agent CLI, agent runtime, unified LLM API) and usage examples"
    },
    "openintelligentui": {
      "repository": "CopilotKit/OpenIntelligentUI",
      "description": "Use for OpenIntelligentUI open-source generative UI framework source code, components, and usage examples"
    }
  }
}